# MoaView local/deployment environment template
# Copy to .env locally or set these values in Vercel/Railway/Supabase dashboards.
# Do not commit real secrets.

# Public web/API routing
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MOAVIEW_WEB_BASE_URL=http://localhost:3000

# Supabase Postgres/Auth
# Fixture-only local tests may leave these blank.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Some Supabase projects still expose this name; prefer PUBLISHABLE_KEY for new setup.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose to browser/client components.
SUPABASE_SERVICE_ROLE_KEY=

# Resend email notifications
# Dry-run mode does not require RESEND_API_KEY.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MoaView <notifications@moaview.local>
NOTIFICATION_DRY_RUN=true

# Worker/mock crawler local state
MOAVIEW_CRAWL_STATE_DIR=.local/crawl-state
