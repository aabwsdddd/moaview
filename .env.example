# MoaView worker/API local environment
# Resend is the planned email provider. Leave blank in tests/local dry-run mode.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MoaView <notifications@moaview.local>
NOTIFICATION_DRY_RUN=true
MOAVIEW_WEB_BASE_URL=http://localhost:3000

# Optional future database integration; fixture-only commands do not require it.
DATABASE_URL=
